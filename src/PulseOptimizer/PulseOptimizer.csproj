<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>PulseOptimizer</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>

    <!-- File properties shown in Windows (right-click > Properties > Details). -->
    <Product>Pulse Optimizer</Product>
    <AssemblyTitle>Pulse Optimizer</AssemblyTitle>
    <Description>Open-source, evidence-based Windows optimizer. Not affiliated with Microsoft or Intel.</Description>
    <Company>Pulse Optimizer (open source)</Company>
    <Copyright>MIT License</Copyright>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
