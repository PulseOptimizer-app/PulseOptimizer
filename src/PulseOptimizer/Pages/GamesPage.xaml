<UserControl x:Class="Pulse.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <UserControl.Resources>
        <!-- Round tick box for checklist steps -->
        <Style x:Key="Tick" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="24" Height="24" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="#3A4562" StrokeThickness="2"/>
                            <Ellipse x:Name="Fill" Fill="{StaticResource AccentGradient}" Opacity="0"/>
                            <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{StaticResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,6,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Games"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="740" HorizontalAlignment="Left"
                       Text="Lower the delay in a specific game. Each checklist is built for your graphics card and monitor, and Pulse can measure the delay before and after."/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Game list -->
            <Grid>
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Spinner Width="22" Height="22" Brush="{StaticResource AccentGradient}"/>
                    <TextBlock Text="Finding your games…" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <ListBox x:Name="GameList" Style="{StaticResource PickList}" SelectionChanged="Game_Selected">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource GoodBrush}" Margin="0,0,8,0"
                                               Visibility="{Binding Running, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Plan -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PlanPanel" Margin="0,0,0,32" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}" Padding="24,22">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock x:Name="GameTitle" Style="{StaticResource H2}" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <Border x:Name="ReflexPill" Style="{StaticResource Pill}" Background="{StaticResource GoodSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="NVIDIA Reflex" Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                                <Border x:Name="AntiLagPill" Style="{StaticResource Pill}" Background="{StaticResource BadSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="AMD Anti-Lag 2" Foreground="{StaticResource BadBrush}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="PlanIntro" Style="{StaticResource Body}"/>
                            <Grid Margin="0,14,0,0">
                                <Border Style="{StaticResource BarTrack}"/>
                                <Border x:Name="PlanBar" Style="{StaticResource BarFill}"/>
                            </Grid>

                            <ItemsControl x:Name="StepList" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16" ui:Anim.Reveal="True">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Done, Mode=TwoWay}" IsEnabled="{Binding CanTick}" Click="Step_Click" Margin="0,1,0,0"/>
                                            <StackPanel Grid.Column="1" Opacity="{Binding Done, Converter={StaticResource BoolToOpacity}, ConverterParameter=invert}">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                                                        Click="StepAction_Click" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                       Text="Menu names can move when a game updates. If a setting isn't where Pulse says, look in the game's Video or Graphics settings."/>
                        </StackPanel>
                    </Border>

                    <!-- Delay check -->
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Check this game's delay"/>
                                    <TextBlock x:Name="CheckIntro" Style="{StaticResource Body}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button x:Name="CheckBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Check_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="13"/>
                                        <TextBlock x:Name="CheckBtnText" Text="Check delay" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CheckRunning" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid Width="48" Height="48" Margin="0,0,14,0">
                                    <ui:Ring x:Name="CheckRing" Thickness="5" Brush="{StaticResource AccentGradient}"/>
                                    <TextBlock x:Name="CheckCount" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CheckStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <UniformGrid x:Name="ResultGrid" Columns="3" Margin="0,18,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Delay"/>
                                    <TextBlock x:Name="DelayValue" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="DelayKind" Style="{StaticResource Body}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Average FPS"/>
                                    <TextBlock x:Name="FpsValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="1% low FPS"/>
                                    <TextBlock x:Name="LowValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CompareText" Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
