<UserControl x:Class="Pulse.Pages.GamesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <Grid Margin="0,6,0,0">
        <!-- ═════════ Library ═════════ -->
        <ScrollViewer x:Name="LibraryView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,36">
                <TextBlock Style="{StaticResource H1}" Text="Games"/>
                <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="740" HorizontalAlignment="Left"
                           Text="Pick a game for a checklist built for your graphics card and monitor: lower delay, more FPS, and a before-and-after check."/>
                <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Margin="0,22,0,0">
                    <ui:Spinner Width="20" Height="20" Brush="{StaticResource AccentGradient}"/>
                    <TextBlock Text="Finding your games…" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
                <ItemsControl x:Name="GameGrid" Margin="0,22,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Style="{StaticResource GameTile}" Click="Tile_Click" ui:Anim.Reveal="True"/>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,24,0" CornerRadius="6" Padding="6,2,6,3" Background="#CC0B0C10"
                                        Visibility="{Binding ProgressText, Converter={StaticResource HasValueToVis}}" IsHitTestVisible="False">
                                    <TextBlock Text="{Binding ProgressText}" Foreground="White" FontSize="10.5"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Suggestions -->
                <TextBlock Style="{StaticResource H2}" Text="Find something new" Margin="0,22,0,4"/>
                <TextBlock x:Name="SuggestBecause" Style="{StaticResource Body}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="GenreChips"/>
                <ItemsControl x:Name="SuggestList" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverCard}" Margin="0,0,10,10" Padding="16,14" ui:Anim.Reveal="True">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid Width="52" Height="74" VerticalAlignment="Top">
                                        <Border CornerRadius="8" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Visibility="{Binding HasCover, Converter={StaticResource InverseBoolToVis}}">
                                            <TextBlock Text="{Binding Initials}" Foreground="{StaticResource TextDimBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="8" ClipToBounds="True" Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                            <Border.Clip><RectangleGeometry Rect="0,0,52,74" RadiusX="8" RadiusY="8"/></Border.Clip>
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="14,0,10,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,1,0,0">
                                            <Run Text="{Binding GenreText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding PriceText, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Why}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="View" VerticalAlignment="Center" Tag="{Binding Link}" Click="Suggest_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0"
                           Text="A hand-picked list that works offline. Pulse only looks at which games are installed; it doesn't track what you play. View opens the store page in your browser."/>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════ One game ═════════ -->
        <ScrollViewer x:Name="DetailView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PlanPanel" Margin="0,0,0,36">
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Back_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource IconText}" FontSize="12"/>
                        <TextBlock Text="All games" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Banner -->
                <Border CornerRadius="14" Margin="0,14,0,16" Height="128" ClipToBounds="True" x:Name="Banner">
                    <Grid>
                        <Image x:Name="BannerBlur" Stretch="UniformToFill" Opacity="0.6" Margin="-40">
                            <Image.Effect><BlurEffect Radius="40"/></Image.Effect>
                        </Image>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#E60B0C10" Offset="0"/>
                                    <GradientStop Color="#400B0C10" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                            <Border Width="76" Height="76" CornerRadius="16" ClipToBounds="True" x:Name="BannerIconBox">
                                <Grid>
                                    <Image x:Name="BannerIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="BannerLetters" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="GameTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock x:Name="GameStatus" FontSize="12.5" Foreground="#CCFFFFFF" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                    <Border Style="{StaticResource Card}" Padding="24,22">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Style="{StaticResource H2}" Text="Lower your delay" Margin="0,0,12,6" VerticalAlignment="Center"/>
                                <Border x:Name="ReflexPill" Style="{StaticResource Pill}" Background="{StaticResource GoodSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="NVIDIA Reflex" Foreground="{StaticResource GoodBrush}"/>
                                </Border>
                                <Border x:Name="AntiLagPill" Style="{StaticResource Pill}" Background="{StaticResource BadSoftBrush}" Margin="0,0,6,6">
                                    <TextBlock Style="{StaticResource PillText}" Text="AMD Anti-Lag 2" Foreground="{StaticResource BadBrush}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock x:Name="PlanIntro" Style="{StaticResource Body}"/>
                            <Grid Margin="0,14,0,0">
                                <Border Style="{StaticResource BarTrack}"/>
                                <Border x:Name="PlanBar" Style="{StaticResource BarFill}"/>
                            </Grid>

                            <ItemsControl x:Name="StepList" Margin="0,18,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16" ui:Anim.Reveal="True">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding Done, Mode=TwoWay}" IsEnabled="{Binding CanTick}" Click="Step_Click" Margin="0,1,0,0"/>
                                            <StackPanel Grid.Column="1" Opacity="{Binding Done, Converter={StaticResource BoolToOpacity}, ConverterParameter=invert}">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding ActionText}" Tag="{Binding ActionKey}"
                                                        Click="StepAction_Click" Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource TextFaintBrush}"
                                       Text="Menu names can move when a game updates. If a setting isn't where Pulse says, look in the game's Video or Graphics settings."/>
                        </StackPanel>
                    </Border>

                    <!-- Delay check -->
                    <Border Style="{StaticResource Card}" Padding="24,22" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource H2}" Text="Check this game's delay"/>
                                    <TextBlock x:Name="CheckIntro" Style="{StaticResource Body}" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                                </StackPanel>
                                <Button x:Name="CheckBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Check_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9D2;" Style="{StaticResource IconText}" FontSize="13"/>
                                        <TextBlock x:Name="CheckBtnText" Text="Check delay" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="CheckRunning" Orientation="Horizontal" Margin="0,16,0,0" Visibility="Collapsed">
                                <Grid Width="48" Height="48" Margin="0,0,14,0">
                                    <ui:Ring x:Name="CheckRing" Thickness="5" Brush="{StaticResource AccentGradient}"/>
                                    <TextBlock x:Name="CheckCount" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="CheckStatus" Style="{StaticResource Body}" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                            </StackPanel>
                            <UniformGrid x:Name="ResultGrid" Columns="3" Margin="0,18,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Delay"/>
                                    <TextBlock x:Name="DelayValue" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock x:Name="DelayKind" Style="{StaticResource Body}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="Average FPS"/>
                                    <TextBlock x:Name="FpsValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="1% low FPS"/>
                                    <TextBlock x:Name="LowValue" FontSize="26" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock x:Name="CompareText" Style="{StaticResource Body}" Margin="0,12,0,0" Foreground="{StaticResource TextBrush}" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
