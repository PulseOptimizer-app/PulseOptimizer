<UserControl x:Class="Pulse.Pages.MeasurePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pulse.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,6,0,32">
            <TextBlock Style="{StaticResource H1}" Text="Measure"/>
            <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Prove whether a tweak helps on your PC, in your game. Pulse records several runs with the tweak off and on, alternating so heat and background tasks affect both sides equally, then only calls it a win if the difference is bigger than your PC's normal run-to-run variation."/>

            <!-- ═════════ Before/after test: setup ═════════ -->
            <Border x:Name="SetupCard" Style="{StaticResource Card}" Margin="0,22,0,0" ui:Anim.Reveal="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Before/after game test"/>
                    <TextBlock x:Name="PresentMonMissing" Style="{StaticResource Body}" Foreground="{StaticResource WarnBrush}" Margin="0,8,0,0" Visibility="Collapsed"
                               Text="PresentMon (Intel's free frame-time tool) wasn't found next to Pulse. Run build.bat again, or put PresentMon.exe in the 'tools' folder beside PulseOptimizer.exe."/>
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="1. TWEAK TO TEST"/>
                            <ListBox x:Name="TweakPick" Style="{StaticResource PickList}" Margin="0,8,0,0" MaxHeight="300" SelectionChanged="Pick_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EvidenceText}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Grid>
                                <TextBlock Style="{StaticResource Label}" Text="2. YOUR GAME (MUST BE RUNNING)" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="Refresh" Click="RefreshGames_Click"/>
                            </Grid>
                            <ListBox x:Name="GamePick" Style="{StaticResource PickList}" Margin="0,8,0,0" MaxHeight="300" SelectionChanged="Pick_Changed">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                <TextBlock Text="{Binding Exe}" FontSize="11.5" Foreground="{StaticResource TextDimBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoGames" Style="{StaticResource Body}" Margin="0,8,0,0" Visibility="Collapsed"
                                       Text="No games found. Start your game, then press Refresh."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource Label}" Text="3. TEST LENGTH" Margin="0,18,0,8"/>
                    <WrapPanel>
                        <RadioButton x:Name="Len60" Style="{StaticResource Chip}" GroupName="Len" Content="60 s per run"/>
                        <RadioButton x:Name="Len75" Style="{StaticResource Chip}" GroupName="Len" Content="75 s per run" IsChecked="True"/>
                        <RadioButton x:Name="Len90" Style="{StaticResource Chip}" GroupName="Len" Content="90 s per run"/>
                        <Border Width="16"/>
                        <RadioButton x:Name="Runs3" Style="{StaticResource Chip}" GroupName="Runs" Content="3 runs each (quick)"/>
                        <RadioButton x:Name="Runs5" Style="{StaticResource Chip}" GroupName="Runs" Content="5 runs each (recommended)" IsChecked="True"/>
                        <RadioButton x:Name="Runs7" Style="{StaticResource Chip}" GroupName="Runs" Content="7 runs each (most reliable)"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                               Text="Use a repeatable scene: the game's built-in benchmark, or the same walk through the same area each time. Pulse adds one warm-up run that isn't counted."/>

                    <Button x:Name="StartBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False" Click="Start_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="13"/>
                            <TextBlock Text="Start test" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═════════ Before/after test: running ═════════ -->
            <Border x:Name="RunCard" Style="{StaticResource Card}" Margin="0,22,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="RunTitle" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="RunSubtitle" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="Cancel test" Click="CancelTest_Click"/>
                    </Grid>

                    <Grid Margin="0,16,0,0">
                        <Border Style="{StaticResource BarTrack}"/>
                        <Border x:Name="RunProgressBar" Style="{StaticResource BarFill}"/>
                    </Grid>

                    <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="10" Background="#0DFFFFFF">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid Width="64" Height="64" Margin="0,0,16,0">
                                <ui:Ring x:Name="CountRing" Thickness="6" Brush="{StaticResource AccentGradient}"/>
                                <TextBlock x:Name="CountText" Text="" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="StepTitle" Style="{StaticResource CardTitle}"/>
                                <TextBlock x:Name="StepText" Style="{StaticResource Body}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="RecordBtn" Style="{StaticResource PrimaryButton}" Click="Record_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" Style="{StaticResource IconText}" FontSize="13"/>
                                <TextBlock x:Name="RecordBtnText" Text="Record next run" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="RestartBtn" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="Restart_Click" Content="Restart PC now"/>
                        <Button x:Name="FinishBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="Finish_Click" Content="See results"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource Label}" Text="RUNS SO FAR" Margin="0,20,0,8"/>
                    <ItemsControl x:Name="RunsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/><ColumnDefinition Width="120"/><ColumnDefinition Width="130"/><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextDimBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Side}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Avg}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Low}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Latency}" Foreground="{StaticResource TextDimBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═════════ Result ═════════ -->
            <Border x:Name="ResultCard" Style="{StaticResource Card}" Margin="0,22,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ResultPill" Style="{StaticResource Pill}">
                            <TextBlock x:Name="ResultPillText" Style="{StaticResource PillText}"/>
                        </Border>
                        <TextBlock x:Name="ResultTitle" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ItemsControl x:Name="ResultList" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Metric}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Body}" Text="{Binding Numbers}"/>
                                    <TextBlock Style="{StaticResource Body}" Foreground="{StaticResource TextBrush}" Text="{Binding Explanation}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="ResultNote" Style="{StaticResource Body}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="KeepBtn" Style="{StaticResource PrimaryButton}" Content="Keep the tweak" Click="Keep_Click"/>
                        <Button x:Name="UndoBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Content="Undo the tweak" Click="Undo_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═════════ Input polling ═════════ -->
            <Border Style="{StaticResource Card}" Margin="0,22,0,0" ui:Anim.Reveal="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Controller and mouse polling"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="How often your device actually sends new input to Windows. Higher and steadier is better. Keep moving the stick or mouse for the whole 5 seconds."/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Padding="16,14" CornerRadius="10" Background="#0DFFFFFF">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Controller" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="PadResult" FontSize="26" FontWeight="Bold" Margin="0,10,0,0" Text="—"/>
                                <TextBlock x:Name="PadDetail" Style="{StaticResource Body}" Text="Xbox controllers, or PlayStation pads through Steam Input / DS4Windows."/>
                                <Button x:Name="PadBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Test controller (5 s)" Click="Pad_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16,14" CornerRadius="10" Background="#0DFFFFFF">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE962;" Style="{StaticResource IconText}" Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="Mouse" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="MouseResult" FontSize="26" FontWeight="Bold" Margin="0,10,0,0" Text="—"/>
                                <TextBlock x:Name="MouseDetail" Style="{StaticResource Body}" Text="Move the mouse in circles during the test."/>
                                <Button x:Name="MouseBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Test mouse (5 s)" Click="Mouse_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═════════ Background CPU + boot ═════════ -->
            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Background CPU"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="What your PC does when you're doing nothing. Close your apps and don't touch the PC for 60 seconds."/>
                        <TextBlock x:Name="CpuResult" FontSize="26" FontWeight="Bold" Margin="0,12,0,0" Text="—"/>
                        <TextBlock x:Name="CpuTop" Style="{StaticResource Mono}" Margin="0,6,0,0"/>
                        <Button x:Name="CpuBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Measure for 60 s" Click="Cpu_Click"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" ui:Anim.Reveal="True">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Boot time"/>
                        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="How long your last starts took, as recorded by Windows itself."/>
                        <TextBlock x:Name="BootResult" FontSize="26" FontWeight="Bold" Margin="0,12,0,0" Text="—"/>
                        <TextBlock x:Name="BootList" Style="{StaticResource Mono}" Margin="0,6,0,0"/>
                        <Button x:Name="BootBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Content="Read boot times" Click="Boot_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
